# -----------------------------------------------------------------------------
# OpenClaw Standalone Deployment Environment Variables
# -----------------------------------------------------------------------------

# (Required) Your OpenAI API Key (or LiteLLM Proxy Virtual Key)
OPENAI_API_KEY=sk-xxxx-xxxx-xxxx

# (Optional) Port to map on the host machine (default: 18789)
HOST_PORT=18789

# (Required) Identities for the AI and the User
USER_NICKNAME=您的名字
BOT_NICKNAME=專屬秘書

# (Optional) Feishu Bot Credentials. 
# If provided, the Feishu plugin will be installed and configured automatically.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_DOMAIN=feishu
# If you want to restrict DMs to a specific Open ID initially:
FEISHU_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxx

# (Optional) Timezone
TZ=Asia/Taipei
