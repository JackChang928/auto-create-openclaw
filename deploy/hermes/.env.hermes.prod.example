# Hermes Agent — 生產環境變數範本
# 複製並修改為 .env.hermes.prod

# ===== AI API Keys =====
OPENAI_API_KEY=sk-xxxx
ANTHROPIC_API_KEY=sk-ant-xxxx
GEMINI_API_KEY=xxx
MINIMAX_API_KEY=xxx

# ===== 頻道設定 =====

# Telegram Bot（可選）
TELEGRAM_BOT_TOKEN=123456:ABC-DEFGH
TELEGRAM_ENABLED=true

# Discord Bot（可選）
DISCORD_BOT_TOKEN=xxxxx
DISCORD_ENABLED=false

# 飛書（可選）
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
FEISHU_ENABLED=false

# ===== 資源配置 =====
HERMES_PORT=18790
HERMES_WS_PORT=18791
HERMES_MEMORY_LIMIT=4g
HERMES_CPU_LIMIT=2
HERMES_SHM_SIZE=256m

# ===== Browser Tools =====
# 開啟後記憶體需求增加到 4GB 以上
HERMES_ENABLE_BROWSER=false

# ===== 模型設定 =====
HERMES_MODEL_PROVIDER=openai
HERMES_MODEL=gpt-4o
HERMES_API_KEY_VAR=OPENAI_API_KEY

# ===== 日誌 =====
HERMES_LOG_LEVEL=INFO
TZ=Asia/Taipei
