# Hermes Agent — 生產環境變數範本（完整版）
# 複製並修改為 .env.hermes.prod

# ===== AI API Keys =====
OPENAI_API_KEY=sk-xxxx
ANTHROPIC_API_KEY=sk-ant-xxxx
GEMINI_API_KEY=xxx
MINIMAX_API_KEY=xxx

# ===== 飛書/Lark（原生支援）=====
# Hermes 內建飛書適配，無需額外插件
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_ENABLED=true

# 飛書連接模式
#   QR_SCAN  — 掃碼配對（用戶在飛書裡搜Bot，Bot回配對碼）
#   ADMIN_APPROVE — 管理員審批
FEISHU_PAIRING_MODE=QR_SCAN

# 群組回應方式
#   AT       — @機器人 才回應
#   ALL      — 所有訊息都回應
FEISHU_GROUP_RESPONSE_MODE=AT

# ===== 頻道設定（Telegram / Discord 等）=====
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_ENABLED=false

DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx
DISCORD_ENABLED=false

SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_ENABLED=false

# ===== 資源配置 =====
HERMES_PORT=18790
HERMES_WS_PORT=18791
HERMES_MEMORY_LIMIT=4g
HERMES_CPU_LIMIT=2
HERMES_SHM_SIZE=256m

# ===== Browser Tools（可選）=====
# 開啟後記憶體需求增加到 4GB 以上
HERMES_ENABLE_BROWSER=false

# ===== 模型設定 =====
HERMES_MODEL_PROVIDER=openai
HERMES_MODEL=gpt-4o
HERMES_API_KEY_VAR=OPENAI_API_KEY

# ===== 日誌 =====
HERMES_LOG_LEVEL=INFO
TZ=Asia/Taipei
